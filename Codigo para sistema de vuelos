        private static void EjecutarBusquedaMulticriterio(GrafoVuelos grafo)
        {
            Console.Clear();
            Console.WriteLine("========================================================================================");
            Console.WriteLine("                 BÚSQUEDA Y OPTIMIZACIÓN DE RUTAS AÉREAS                                ");
            Console.WriteLine("========================================================================================");
            Console.Write("Ingrese código del Aeropuerto Origen (ej. UIO, SPO, CUE): ");
            string origen = Console.ReadLine()?.Trim().ToUpper() ?? "";
            Console.Write("Ingrese código del Aeropuerto Destino (ej. MIA, GPS, GYE): ");
            string destino = Console.ReadLine()?.Trim().ToUpper() ?? "";

            Console.WriteLine("\nSeleccione el Criterio de Optimización:");
            Console.WriteLine(" 1. Ruta MÁS BARATA (Menor Costo)");
            Console.WriteLine(" 2. Ruta MÁS RÁPIDA (Menor Tiempo Total)");
            Console.WriteLine(" 3. Ruta MÁS DIRECTA (Menor Cantidad de Escalas)");
            Console.Write("Opción (1-3): ");

            if (!Enum.TryParse(Console.ReadLine()?.Trim(), out CriterioBusqueda criterio))
            {
                criterio = CriterioBusqueda.MenorPrecio;
            }

            var res = MotorRutas.EncontrarRutaOptima(grafo, origen, destino, criterio);

            if (!res.Exito)
            {
                Console.WriteLine("\n[RESULTADO] No se encontró ninguna ruta válida entre los aeropuertos especificados.");
                return;
            }

            Console.WriteLine("\n----------------------------------------------------------------------------------------");
            Console.WriteLine($"RUTA ÓPTIMA ENCONTRADA (Criterio: {res.CriterioUsado}):");
            Console.Write($" {res.NodosRuta[0]} ");
            for (int i = 0; i < res.DetalleConexiones.Count; i++)
            {
                var c = res.DetalleConexiones[i];
                Console.Write($"--[{c.Aerolinea} | ${c.Precio:F2} | {c.DuracionMinutos}m]--> {res.NodosRuta[i + 1]} ");
            }

            Console.WriteLine("\n\nRESUMEN DE ITINERARIO:");
            Console.WriteLine($" - Escalas Intermedias : {res.DetalleConexiones.Count - 1}");
            Console.WriteLine($" - Tiempo Total Vuelo : {res.TiempoTotalMinutos / 60}h {res.TiempoTotalMinutos % 60}m");
            Console.WriteLine($" - Costo Total Boleto : ${res.CostoTotal:F2}");
            Console.WriteLine("----------------------------------------------------------------------------------------");
            Console.WriteLine("MÉTRICAS Y COMPLEJIDAD DEL ALGORITMO:");
            Console.WriteLine($" - Tiempo de Ejecución   : {res.TiempoEjecucionMs:F3} ms");
            Console.WriteLine($" - Relajaciones de Aristas: {res.IteracionesRelajacion}");
            Console.WriteLine(" - Complejidad Teórica   : O((V + E) log V) mediante PriorityQueue");
            Console.WriteLine("========================================================================================");

            Console.Write("\n¿Desea exportar este itinerario a un archivo de texto? (S/N): ");
            if (Console.ReadLine()?.Trim().ToUpper() == "S")
            {
                ExportarItinerarioTexto(res);
            }
        }

        private static void ExportarItinerarioTexto(MotorRutas.ResultadoRuta res)
        {
            string nombreArchivo = $"Itinerario_{res.NodosRuta.First()}_{res.NodosRuta.Last()}.txt";
            StringBuilder sb = new StringBuilder();

            sb.AppendLine("==========================================================");
            sb.AppendLine("           UNIVERSIDAD ESTATAL AMAZÓNICA                  ");
            sb.AppendLine("           COMPROBANTE DE ITINERARIO DE VUELO             ");
            sb.AppendLine("==========================================================");
            sb.AppendLine($"Fecha de Consulta : {DateTime.Now:yyyy-MM-dd HH:mm:ss}");
            sb.AppendLine($"Ruta Solicitada  : {res.NodosRuta.First()} -> {res.NodosRuta.Last()}");
            sb.AppendLine($"Criterio Utilizado: {res.CriterioUsado}");
            sb.AppendLine("----------------------------------------------------------");
            sb.AppendLine("DETALLE DEL ITINERARIO:");

            for (int i = 0; i < res.DetalleConexiones.Count; i++)
            {
                var c = res.DetalleConexiones[i];
                sb.AppendLine($"  Tramo {i + 1}: {res.NodosRuta[i]} -> {res.NodosRuta[i + 1]} | {c.Aerolinea} | Costo: ${c.Precio:F2} | Duración: {c.DuracionMinutos} min");
            }

            sb.AppendLine("----------------------------------------------------------");
            sb.AppendLine($"Tiempo Total Estimado : {res.TiempoTotalMinutos / 60}h {res.TiempoTotalMinutos % 60}m");
            sb.AppendLine($"Costo Total Boleto    : ${res.CostoTotal:F2}");
            sb.AppendLine("==========================================================");

            File.WriteAllText(nombreArchivo, sb.ToString());
            Console.WriteLine($"\n[ÉXITO] Itinerario guardado exitosamente en '{nombreArchivo}'.");
        }

        private static void AgregarRutaManual(GrafoVuelos grafo)
        {
            Console.Clear();
            Console.WriteLine("==================================================================");
            Console.WriteLine("               REGISTRAR NUEVA RUTA DE VUELO                      ");
            Console.WriteLine("==================================================================");

            Console.Write("Código IATA Origen (ej. UIO): ");
            string origen = Console.ReadLine()?.Trim().ToUpper() ?? "";

            Console.Write("Código IATA Destino (ej. GYE): ");
            string destino = Console.ReadLine()?.Trim().ToUpper() ?? "";

            Console.Write("Nombre de la Aerolínea: ");
            string aerolinea = Console.ReadLine()?.Trim() ?? "AeroEcuador";

            Console.Write("Precio del Boleto (USD): ");
            if (!decimal.TryParse(Console.ReadLine()?.Trim(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal precio))
            {
                precio = 100.00m;
            }

            Console.Write("Duración Estimada (Minutos): ");
            if (!int.TryParse(Console.ReadLine()?.Trim(), out int duracion))
            {
                duracion = 60;
            }

            grafo.AgregarVuelo(origen, destino, aerolinea, precio, duracion);

            // Persistir en el archivo base_vuelos.txt
            string linea = $"{origen},{destino},{aerolinea},{precio.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)},{duracion}";
            File.AppendAllLines(RutaArchivo, new[] { linea });

            Console.WriteLine("\n[ÉXITO] La nueva ruta ha sido agregada e insertada en el archivo de base de datos.");
        }

