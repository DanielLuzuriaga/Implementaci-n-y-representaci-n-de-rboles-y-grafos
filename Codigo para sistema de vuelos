    // Criterios de optimización algorítmica
    public enum CriterioBusqueda
    {
        MenorPrecio = 1,
        MenorTiempo = 2,
        MenorEscalas = 3
    }

    // Arista ponderada con múltiples atributos (Precio y Tiempo)
    public class ConexionVuelo
    {
        public string Destino { get; set; }
        public string Aerolinea { get; set; }
        public decimal Precio { get; set; }
        public int DuracionMinutos { get; set; }

        public ConexionVuelo(string destino, string aerolinea, decimal precio, int duracionMinutos)
        {
            Destino = destino;
            Aerolinea = aerolinea;
            Precio = precio;
            DuracionMinutos = duracionMinutos;
        }
    }

    // Gestor de la Estructura de Datos (Lista de Adyacencia y Matriz de Adyacencia)
    public class GrafoVuelos
    {
        private readonly Dictionary<string, List<ConexionVuelo>> _listaAdyacencia;

        public GrafoVuelos()
        {
            _listaAdyacencia = new Dictionary<string, List<ConexionVuelo>>(StringComparer.OrdinalIgnoreCase);
        }

        public void AgregarAeropuerto(string codigo)
        {
            if (!_listaAdyacencia.ContainsKey(codigo))
            {
                _listaAdyacencia[codigo] = new List<ConexionVuelo>();
            }
        }

        public void AgregarVuelo(string origen, string destino, string aerolinea, decimal precio, int duracionMinutos)
        {
            AgregarAeropuerto(origen);
            AgregarAeropuerto(destino);
            _listaAdyacencia[origen].Add(new ConexionVuelo(destino, aerolinea, precio, duracionMinutos));
        }

        public bool ExisteAeropuerto(string codigo) => _listaAdyacencia.ContainsKey(codigo);

        public Dictionary<string, List<ConexionVuelo>> ObtenerListaAdyacencia() => _listaAdyacencia;

        public List<string> ObtenerNodos() => _listaAdyacencia.Keys.OrderBy(k => k).ToList();

        public int ObtenerTotalVértices() => _listaAdyacencia.Count;

        public int ObtenerTotalAristas() => _listaAdyacencia.Values.Sum(lista => lista.Count);

        // Genera la Matriz de Adyacencia basada en los precios de los vuelos
        public (decimal[,] Matriz, List<string> IndiceNodos) ObtenerMatrizAdyacencia()
        {
            var nodos = ObtenerNodos();
            int n = nodos.Count;
            decimal[,] matriz = new decimal[n, n];

            for (int i = 0; i < n; i++)
            {
                for (int j = 0; j < n; j++)
                {
                    matriz[i, j] = (i == j) ? 0 : -1; // -1 indica ausencia de conexión directa
                }
            }

            for (int i = 0; i < n; i++)
            {
                string origen = nodos[i];
                foreach (var conexion in _listaAdyacencia[origen])
                {
                    int j = nodos.IndexOf(conexion.Destino);
                    if (j != -1)
                    {
                        if (matriz[i, j] == -1 || conexion.Precio < matriz[i, j])
                        {
                            matriz[i, j] = conexion.Precio;
                        }
                    }
                }
            }

            return (matriz, nodos);
        }
    }

    // Motor Algorítmico Multicriterio (Dijkstra)
    public class MotorRutas
    {
        public class ResultadoRuta
        {
            public List<string> NodosRuta { get; set; } = new List<string>();
            public List<ConexionVuelo> DetalleConexiones { get; set; } = new List<ConexionVuelo>();
            public decimal CostoTotal { get; set; }
            public int TiempoTotalMinutos { get; set; }
            public double TiempoEjecucionMs { get; set; }
            public int IteracionesRelajacion { get; set; }
            public CriterioBusqueda CriterioUsado { get; set; }
            public bool Exito { get; set; }
        }

        public static ResultadoRuta EncontrarRutaOptima(GrafoVuelos grafo, string origen, string destino, CriterioBusqueda criterio)
        {
            var resultado = new ResultadoRuta { CriterioUsado = criterio };
            var cronometro = Stopwatch.StartNew();

            if (!grafo.ExisteAeropuerto(origen) || !grafo.ExisteAeropuerto(destino))
            {
                cronometro.Stop();
                resultado.Exito = false;
                return resultado;
            }

            var distancias = new Dictionary<string, decimal>();
            var previos = new Dictionary<string, (string NodoAnterior, ConexionVuelo Conexion)>();
            var colaPrioridad = new PriorityQueue<string, decimal>();

            foreach (var nodo in grafo.ObtenerListaAdyacencia().Keys)
            {
                distancias[nodo] = decimal.MaxValue;
            }

            distancias[origen] = 0;
            colaPrioridad.Enqueue(origen, 0);

            int contadorRelajaciones = 0;

            while (colaPrioridad.Count > 0)
            {
                var nodoActual = colaPrioridad.Dequeue();

                if (nodoActual.Equals(destino, StringComparison.OrdinalIgnoreCase))
                    break;

                foreach (var vecino in grafo.ObtenerListaAdyacencia()[nodoActual])
                {
                    contadorRelajaciones++;

                    // Determinación del peso según el criterio
                    decimal pesoArista = criterio switch
                    {
                        CriterioBusqueda.MenorPrecio => vecino.Precio,
                        CriterioBusqueda.MenorTiempo => vecino.DuracionMinutos,
                        CriterioBusqueda.MenorEscalas => 1,
                        _ => vecino.Precio
                    };

                    decimal nuevaDistancia = distancias[nodoActual] + pesoArista;

                    if (nuevaDistancia < distancias[vecino.Destino])
                    {
                        distancias[vecino.Destino] = nuevaDistancia;
                        previos[vecino.Destino] = (nodoActual, vecino);
                        colaPrioridad.Enqueue(vecino.Destino, nuevaDistancia);
                    }
                }
            }

            cronometro.Stop();
            resultado.TiempoEjecucionMs = cronometro.Elapsed.TotalMilliseconds;
            resultado.IteracionesRelajacion = contadorRelajaciones;

            if (distancias[destino] == decimal.MaxValue)
            {
                resultado.Exito = false;
                return resultado;
            }

            // Reconstrucción del camino
            var pasoActual = destino;
            while (previos.ContainsKey(pasoActual))
            {
                var info = previos[pasoActual];
                resultado.NodosRuta.Insert(0, pasoActual);
                resultado.DetalleConexiones.Insert(0, info.Conexion);
                resultado.CostoTotal += info.Conexion.Precio;
                resultado.TiempoTotalMinutos += info.Conexion.DuracionMinutos;
                pasoActual = info.NodoAnterior;
            }
            resultado.NodosRuta.Insert(0, origen);
            resultado.Exito = true;

            return resultado;
        }
    }

    // Interfaz de Usuario e Integración de Funcionalidades
    public class Program
    {
        private const string RutaArchivo = "base_vuelos.txt";

        public static void Main(string[] args)
        {
