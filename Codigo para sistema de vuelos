                {
                    Console.WriteLine("(Sin vuelos salientes)");
                }
                else
                {
                    var conexiones = kvp.Value.Select(c => $"({c.Destino} | {c.Aerolinea} | ${c.Precio:F2} | {c.DuracionMinutos}m)");
                    Console.WriteLine(string.Join(" -> ", conexiones));
                }
