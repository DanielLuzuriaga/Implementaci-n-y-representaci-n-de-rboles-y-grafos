            if (!File.Exists(RutaArchivo))
            {
                GenerarArchivoBaseFicticio(RutaArchivo);
            }

            GrafoVuelos grafo = CargarGrafoDesdeArchivo(RutaArchivo);

            bool salir = false;
            while (!salir)
            {
                MostrarEncabezadoInstitucional();
                Console.WriteLine("1. Reportería Completa (Lista y Matriz de Adyacencia)");
                Console.WriteLine("2. Buscar Ruta Óptima (Precio / Tiempo / Escalas)");
                Console.WriteLine("3. Registrar Nueva Ruta Aérea (CRUD / Persistencia)");
                Console.WriteLine("4. Recargar Base de Datos de Vuelos");
                Console.WriteLine("5. Salir del Programa");
                Console.WriteLine("==================================================================");
                Console.Write("Seleccione una opción (1-5): ");

                switch (Console.ReadLine()?.Trim())
                {
                    case "1":
                        MostrarReporteriaEstructura(grafo);
                        Pausar();
                        break;
                    case "2":
                        EjecutarBusquedaMulticriterio(grafo);
                        Pausar();
                        break;
                    case "3":
                        AgregarRutaManual(grafo);
                        Pausar();
                        break;
                    case "4":
                        GenerarArchivoBaseFicticio(RutaArchivo);
                        grafo = CargarGrafoDesdeArchivo(RutaArchivo);
                        Console.WriteLine("\n[ÉXITO] Base de datos restaurada correctamente.");
                        Pausar();
                        break;
                    case "5":
                        salir = true;
                        break;
                    default:
                        Console.WriteLine("\n[ERROR] Opción no válida. Intente de nuevo.");
                        Pausar();
                        break;
                }
            }
        }

