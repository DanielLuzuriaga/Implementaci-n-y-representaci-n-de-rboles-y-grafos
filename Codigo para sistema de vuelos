            Console.WriteLine("========================================================================================");
            Console.WriteLine("           1. VISTA DE LISTA DE ADYACENCIA (CONEXIONES DIRECTAS)                        ");
            Console.WriteLine("========================================================================================");

            foreach (var kvp in grafo.ObtenerListaAdyacencia())
            {
