        private static GrafoVuelos CargarGrafoDesdeArchivo(string ruta)
        {
            var grafo = new GrafoVuelos();
            foreach (var linea in File.ReadAllLines(ruta))
            {
                if (string.IsNullOrWhiteSpace(linea) || linea.StartsWith("#")) continue;
                var partes = linea.Split(',');
                if (partes.Length >= 5)
                {
                    string origen = partes[0].Trim().ToUpper();
                    string destino = partes[1].Trim().ToUpper();
                    string aerolinea = partes[2].Trim();

                    if (decimal.TryParse(partes[3].Trim(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal precio) &&
                        int.TryParse(partes[4].Trim(), out int duracion))
                    {
                        grafo.AgregarVuelo(origen, destino, aerolinea, precio, duracion);
                    }
                }
            }
            return grafo;
        }

